<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Form 1" Height="190" Width="300" Background="#FFEEDAC6" UseLayoutRounding="False" Icon="/BIM+A LOGO.jpg">

    <!--Windows Styles-->
    <Window.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    <!--TextBox Styles-->
        <Style TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        
                        <Border CornerRadius="5"
                                Background="{TemplateBinding Background}">
                            
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <!--Combobox Styles-->
        <Style TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <!-- Caixa principal -->
                            <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="5">

                                <Grid>

                                    <!-- Item selecionado -->
                                    <ContentPresenter
                                Margin="8,0,25,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                                    <!-- Botão da seta -->
                                    <ToggleButton
                                Width="25"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                IsChecked="{Binding IsDropDownOpen,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    Mode=TwoWay}">

                                        <Path
                                    Data="M 0 0 L 4 4 L 8 0"
                                    Stroke="#FF666666"
                                    StrokeThickness="1.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                    </ToggleButton>

                                </Grid>

                            </Border>

                            <!-- Dropdown -->
                            <Popup
                        x:Name="PART_Popup"
                        IsOpen="{TemplateBinding IsDropDownOpen}"
                        Placement="Bottom"
                        AllowsTransparency="True">

                                <Border
                            Background="White"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            CornerRadius="5">

                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>



    <StackPanel>
        
        <!--First Label and Textbox-->
        <DockPanel Margin="10">

            <TextBlock Text="Input A" 
                       Margin="0,0,10,0" 
                       FontFamily="Arial" 
                       FontWeight="Bold" 
                       Foreground="#FFAA6521"/>
            <TextBox Text="Default Value..." 
                     Background="LightGray" 
                     Foreground="#FF957C68" 
                     FontFamily="Arial" 
                     FontSize="10"/>

        </DockPanel>
        
        <!--Second Label and Textbox-->
        <DockPanel Margin="10">

            <TextBlock Text="Input B" 
                       Margin="0,0,10,0" 
                       FontFamily="Arial" 
                       FontWeight="Bold" 
                       Foreground="#FFAA6521"/>
            <TextBox Text="Default Value..." 
                     Background="LightGray" 
                     Foreground="#FF957C68" 
                     FontSize="10"/>

        </DockPanel>
        
        <!--Third Label and Combobox-->
        <DockPanel Margin="10">

            <TextBlock Text="Input C" 
                       Margin="0,0,10,0" 
                       FontFamily="Arial" 
                       FontWeight="Bold" 
                       Foreground="#FFAA6521"/>
            <ComboBox Foreground="#FFAC7F0F" 
                      FontSize="10" 
                      Background="LightGray"
                      BorderThickness="0">
                
                <ComboBoxItem Content= "Walls"/>
                <ComboBoxItem Content= "Floors" IsSelected="True"/>
                <ComboBoxItem Content= "Windows"/>
                
            </ComboBox>
                
        </DockPanel>
        
        <!--Separator-->
        <Separator Margin="10,0,10,0"/>
        
        <!--Submit Button-->
        <Button Content="Submit!" Margin="10,10,10,0"/>
    </StackPanel>
</Window>
